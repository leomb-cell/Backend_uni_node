generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
  moduleFormat = "esm"
  generatedFileExtension = "ts"
  importFileExtension = "ts"
}

datasource db {
  provider = "postgresql"
}

model User {
  id     Int     @id @default(autoincrement())
  name   String
  orders Order[]
}

model Order {
  id     Int   @id @default(autoincrement())
  total  Float
  userId Int
  user   User  @relation(fields: [userId], references: [id])
}